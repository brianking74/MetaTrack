# Copy this file to .env.local for local development (never commit .env.local)
# In production, set the same variables in Netlify -> Site configuration -> Environment variables
#
# Values come from: Supabase Dashboard -> Your project -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
